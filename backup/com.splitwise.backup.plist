<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.splitwise.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/backup/pull_backup.sh</string>
  </array>
  <!-- After the server's 03:30 snapshot. If the Mac was asleep, launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Backups/splitwise/pull.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Backups/splitwise/pull.log</string>
</dict>
</plist>

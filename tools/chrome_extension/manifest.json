{
  "manifest_version": 3,
  "name": "Splitwise Blinkit Sync",
  "version": "1.0.0",
  "description": "Automatically sync raw Blinkit orders to Splitwise backend",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://*.blinkit.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://13.235.142.203/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
